# ==============================================================================
# Apache Hadoop & Apache Hive Multi-Node Cluster Environment Variables
# Copy to .env for local customization (Do not commit sensitive values)
# ==============================================================================

# Software Versions
HADOOP_VERSION=3.3.6
HIVE_VERSION=4.0.1
ZOOKEEPER_VERSION=3.8.0
JAVA_VERSION=17

# Cluster Network Settings
MASTER_IP=192.168.56.10
WORKER1_IP=192.168.56.11
WORKER2_IP=192.168.56.12
NETWORK_SUBNET=192.168.56.0/24

# MariaDB Metastore Configuration (Lab Default - Change in Production)
HIVE_DB_NAME=metastore_db
HIVE_DB_USER=hive
HIVE_DB_PASSWORD=hive

# HDFS Storage Allocation
HDFS_REPLICATION=2
YARN_NODEMANAGER_MB=1024
MAPREDUCE_CONTAINER_MB=512
